<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.manualprecond"
    android:versionCode="5"
    android:versionName="0.1.4">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Holo.NoActionBar">

        <!-- The Precondition screen. HMG-API opens it from the app-menu tile (mod.json
             provides.launcher), a wheel star hold (input "open") and the star key menu.
             No LAUNCHER category: the tile is HMG-API's, so the stock launcher shows no second one. -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Start/stop without opening the screen: a wheel star hold (mod.json input
             "broadcast") and the star key menu entry (provides.star_key). HMG-API's own checks
             apply to every start, whoever sends this. -->
        <receiver android:name=".ToggleReceiver" android:exported="true">
            <intent-filter>
                <action android:name="dev.manualprecond.TOGGLE" />
            </intent-filter>
        </receiver>

        <!-- After a start: watches HMG-API's conditioning.state and shows the car's notice. -->
        <service android:name=".WatchService" android:exported="false" />
    </application>
</manifest>
